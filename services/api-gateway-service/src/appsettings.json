{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "movies-route": {
        "ClusterId": "movie-cluster",
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "showtimes-route": {
        "ClusterId": "movie-cluster",
        "Match": {
          "Path": "/api/showtimes/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "seats-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/api/seats/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "movie-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7087"
          }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7019"
          }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "JWT_SECRET_KEY"
  }
}
