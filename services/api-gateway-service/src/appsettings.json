{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "movies-route": {
        "ClusterId": "movie-service-containers",
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "showtimes-route": {
        "ClusterId": "movie-service-containers",
        "Match": {
          "Path": "/api/showtimes/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservation-service-containers",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "seats-route": {
        "ClusterId": "reservation-service-containers",
        "Match": {
          "Path": "/api/seats/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "movie-service-containers": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7087"
          }
        }
      },
      "reservation-service-containers": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7019"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
