{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "OpenTelemetry": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Reservation Service"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "movies-route": {
        "ClusterId": "movie-cluster",
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "showtimes-route": {
        "ClusterId": "movie-cluster",
        "Match": {
          "Path": "/api/showtimes/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "seats-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/api/seats/{**catch-all}"
        }
      },
      "movie-service-api-documentation-route": {
        "ClusterId": "movie-cluster",
        "Match": {
          "Path": "/movie-service/api-documentation"
        }
      },
      "reservation-service-api-documentation-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/reservation-service/api-documentation"
        }
      }
    },
    "Clusters": {
      "movie-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7087"
          }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7019"
          }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "JWT_SECRET_KEY"
  }
}
