{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Identity Service"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "JWT_SECRET_KEY"
  },
  "MongoDbSettings": {
    "ConnectionString": "IDENTITY_SERVICE_MONGO_DATABASE_CONNECTION_STRING",
    "DatabaseName": "identity_db"
  }
}
