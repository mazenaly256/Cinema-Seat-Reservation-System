{
  "ConnectionStrings": {
    "Default": "RESERVATION_SERVICE_DATABASE_CONNECTION_STRING"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Reservation Service"
    }
  },
  "AllowedHosts": "*",
  "movieServiceBaseUrl": "http://localhost:7087",
  "API_Gateway_URL": "http://localhost:5241"
}
